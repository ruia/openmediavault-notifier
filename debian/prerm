#!/usr/bin/env dash

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

TRANSPORT_MAP="/etc/postfix/notifier_transport"

case "$1" in
	remove)
		# Empty the transport map first, so the stock emails are delivered
		# again even if the Postfix configuration below cannot be deployed.
		if [ -e "${TRANSPORT_MAP}" ]; then
			echo "# Managed by openmediavault-notifier." > "${TRANSPORT_MAP}"
			postmap "${TRANSPORT_MAP}"
		fi

		postfix_changed=0
		maps="$(omv-env get --value-only OMV_POSTFIX_MAIN_TRANSPORT_MAPS || :)"
		case "${maps}" in
			*"hash:${TRANSPORT_MAP}"*)
				maps="$(echo "${maps}" | sed -e "s#,[[:space:]]*hash:${TRANSPORT_MAP}##" \
					-e "s#hash:${TRANSPORT_MAP},[[:space:]]*##")"
				if [ "${maps}" = "hash:/etc/postfix/transport" ] || [ "${maps}" = "hash:${TRANSPORT_MAP}" ]; then
					omv-env unset OMV_POSTFIX_MAIN_TRANSPORT_MAPS
				else
					omv-env set -- OMV_POSTFIX_MAIN_TRANSPORT_MAPS "${maps}"
				fi
				postfix_changed=1
			;;
		esac
		if [ "$(omv-env get --value-only OMV_POSTFIX_MAIN_DEFAULT_TRANSPORT || :)" = "discard" ] &&
				[ "$(omv_config_get "/config/services/notifier/replaceemail")" = "1" ]; then
			omv-env unset OMV_POSTFIX_MAIN_DEFAULT_TRANSPORT
			postfix_changed=1
		fi

		if [ "${postfix_changed}" = "1" ]; then
			echo "Restoring openmediavault email delivery ..."
			if ! LC_ALL=C.UTF-8 omv-salt stage run --no-color --quiet prepare ||
					! LC_ALL=C.UTF-8 omv-salt deploy run --no-color --quiet postfix; then
				echo "Updating the Postfix configuration failed. Mail is delivered normally, but main.cf still lists ${TRANSPORT_MAP}. Run 'omv-salt stage run prepare' and 'omv-salt deploy run postfix' once the problem is fixed." >&2
			fi
		fi
	;;

	upgrade|failed-upgrade|deconfigure)
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
